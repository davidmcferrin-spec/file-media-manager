# Application
APP_NAME="Media Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database (SQLite path relative to project root)
DB_PATH=data/media-manager.db

# Session
SESSION_NAME=media_manager_session
SESSION_LIFETIME=28800

# CSRF
CSRF_TTL_SECONDS=3600

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# FFmpeg/FFprobe binaries
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# Thumbnail settings
THUMBNAIL_OFFSET_SECONDS=50
THUMBNAIL_WIDTH=320
THUMBNAIL_QUALITY=5

# NAS Sources (configured in UI, these are defaults for setup.sh seeding)
NAS_NY_PATH=/mnt-smb/SNSEVO-NYL
NAS_CHI_PATH=/mnt-smb/SNSEVO-CHL

# Storage paths
STORAGE_THUMBNAILS=storage/thumbnails
STORAGE_LOGS=storage/logs
STORAGE_BACKUPS=storage/backups

# Split flagging — files longer than this (seconds) are auto-flagged
SPLIT_FLAG_THRESHOLD_SECONDS=3600

# First admin user (used by setup.sh only)
SEED_ADMIN_EMAIL=admin@newsnation.com
SEED_ADMIN_PASSWORD=
