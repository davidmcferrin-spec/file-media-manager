# Application
APP_NAME="Media Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:81

# PostgreSQL (used by setup.sh and PHP app)
DATABASE_URL="postgresql://media_manager:media_manager@127.0.0.1:5432/media_manager"
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=media_manager
DB_USER=media_manager
DB_PASSWORD=media_manager

# Session
SESSION_NAME=media_manager_session
SESSION_LIFETIME=28800

# CSRF
CSRF_TTL_SECONDS=3600

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# FFmpeg/FFprobe binaries
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# Thumbnail settings
THUMBNAIL_OFFSET_SECONDS=50
THUMBNAIL_WIDTH=320
THUMBNAIL_QUALITY=5

# Video preview (queue modal — on-demand WebM proxy with audio)
PREVIEW_DURATION_SECONDS=180
PREVIEW_WIDTH=420
PREVIEW_HEIGHT=236
STORAGE_PREVIEWS=storage/previews

# NAS Sources (configured in UI, these are defaults for setup.sh seeding)
NAS_NY_PATH=/mnt-smb/SNSEVO-NYL
NAS_CHI_PATH=/mnt-smb/SNSEVO-CHL

# Storage paths
STORAGE_THUMBNAILS=storage/thumbnails
STORAGE_LOGS=storage/logs
STORAGE_BACKUPS=storage/backups

# Split flagging — fallback only if system_settings keys are missing.
# Prefer Settings → Processing in the UI.
SPLIT_FLAG_THRESHOLD_SECONDS=5400
SPLIT_STRONG_THRESHOLD_SECONDS=10800

# Broadcast continuity check — second-pass confidence refine during Scan/Reclassify.
# Prefer Settings → Processing toggle; these are install defaults / fallbacks.
CONTINUITY_CHECK_ENABLED=true
CONTINUITY_CHECK_URL=http://127.0.0.1:11434
CONTINUITY_CHECK_MODEL=llama3.2:3b
CONTINUITY_CHECK_TIMEOUT_SECONDS=60
# Keep the pack loaded in Ollama after each request (e.g. 24h, 30m, or -1 = until Ollama restarts).
# Also recommended on the Ollama host: OLLAMA_KEEP_ALIVE=24h
CONTINUITY_CHECK_KEEP_ALIVE=24h
# Parallel continuity evals during Scan/Reclassify (1–8). Match Ollama's OLLAMA_NUM_PARALLEL.
CONTINUITY_CHECK_CONCURRENCY=4

# Danger Zone — allow Settings → Danger Zone wipe (default off)
ALLOW_DB_WIPE=false

# LDAP (optional — primary config is in Settings UI)
LDAP_ENABLED=false
LDAP_HOST=
LDAP_PORT=389

# First admin user (used by setup.sh only)
SEED_ADMIN_EMAIL=admin@newsnation.com
SEED_ADMIN_PASSWORD=
